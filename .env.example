# Copy to .env and replace every change-me value. Never commit .env.
DB_NAME=dpw_fms
DB_URL=jdbc:postgresql://localhost:5432/dpw_fms
DB_USER=dpwfms_app
DB_PASSWORD=change-me-database-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=dpwfms_app
RABBITMQ_PASSWORD=change-me-rabbitmq-password
DPWFMS_LOCAL_USERNAME=local-admin
DPWFMS_LOCAL_PASSWORD=change-me-at-least-12-characters
# Used only when scripts/add-sample-users.sh or .ps1 is explicitly run.
# Known local-only Eclipse/dev credential. Override it for shared environments.
DPWFMS_SAMPLE_USER_PASSWORD=DemoOnly!2026
DPWFMS_SAMPLE_USERS_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SERVER_PORT=8080
FRONTEND_PORT=3000
AUTOMATION_EVALUATION_INTERVAL_MS=30000
CHARGING_THRESHOLD_PERCENT=20
TERMINAL_TIMEZONE=Asia/Dubai
MAP_PROVIDER=offline
GOOGLE_MAPS_KEY_REFERENCE=
MAPBOX_TOKEN_REFERENCE=
OFFLINE_TILE_URL=/tiles/{z}/{x}/{y}.png
OFFLINE_STYLE_URL=/maps/style.json
DEFAULT_LATITUDE=24.9857
DEFAULT_LONGITUDE=55.0273
DEFAULT_ZOOM=12
KERNEL_ENABLED=false
KERNEL_ENDPOINT=
